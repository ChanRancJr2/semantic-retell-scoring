# ===== 火山引擎（豆包）配置 =====
# 火山方舟大模型 API Key
ARK_API_KEY=ark-xxxxxxxxxxxxxxxxxxxxxxxx
# 方舟接口地址（OpenAI 兼容）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型/推理接入点 ID（在方舟控制台“开通管理/推理接入点”查看，形如 ep-xxxx 或模型名）
ARK_MODEL_ID=doubao-1-5-pro-32k-250115

# 豆包语音专用 API Key（在豆包语音控制台“API Key管理”获取，与方舟 ark- Key 不同）
SPEECH_API_KEY=

# 豆包语音 录音文件识别 资源 ID（模型2.0标准版）
SPEECH_RESOURCE_ID=volc.seedasr.auc

# 本服务公网访问地址（部署后填写，用于拼接火山识别所需的音频URL）
PUBLIC_BASE_URL=

# 评分模式：mock=本地模拟评分（无需Key也能跑通全流程）；real=调用真实火山服务
AI_MODE=mock

# 服务端口（可选，默认 3000）
PORT=3000
